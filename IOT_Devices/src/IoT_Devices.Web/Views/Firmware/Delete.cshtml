@model IOT_Devices.Models.Firmware
@{
    ViewData["Title"] = "Delete firmware";
    bool inUse = Model.Devices.Any();
}

<h1>Delete firmware</h1>

<p><strong>@Model.DeviceType?.Name</strong> - version <strong>@Model.Version</strong></p>

@if (inUse)
{
    <div class="alert alert-warning">
        Firmware cannot be deleted. 
        Move those devices to another firmware version first.
    </div>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
}
else
{
    <p>Are you sure you want to delete the firmware? </p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
}